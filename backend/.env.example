# Example environment variables for AI Interview Simulation backend
# Copy to .env and adjust values for local development or production.

# SQLAlchemy DATABASE_URL examples:
# sqlite (local dev): sqlite:///./dev.db
# postgresql production: postgresql+psycopg2://user:password@host:5432/ai_interview_simulation
DATABASE_URL=sqlite:///./dev.db

# ChromaDB persistent path (optional override)
CHROMA_DB_PATH=./backend/chroma_db

# Ollama model (used by app.rag.llm)
LLM_MODEL=llama3.2

# Embedding model name (if using SentenceTransformers via LangChain)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Auth (JWT)
SECRET_KEY=change-me-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REQUIRE_AUTH=false

# Speech-to-text (Groq uses the OpenAI-compatible Whisper API)
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_TIMEOUT_SECONDS=30

# Text-to-speech (Gemini API native audio generation)
TTS_PROVIDER=gemini
TTS_API_KEY=
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
TTS_TIMEOUT_SECONDS=15

# Local finalized interview audio storage (disabled by default)
AUDIO_STORAGE_PATH=./backend/audio
ENABLE_AUDIO_PERSISTENCE=false
